<Window x:Class="EMR_Search.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EMR Patient Search" Height="680" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="SearchLabel" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Padding" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style x:Key="WideSearchBox" TargetType="TextBox" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Width" Value="180"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#2B579A" Padding="12,8">
            <DockPanel>
                <TextBlock Text="EMR Patient Search" FontSize="15" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRefresh" Content="Refresh Data" Click="BtnRefresh_Click"
                            Background="#1E3F7A" Foreground="White" BorderBrush="#4A7FBA"
                            ToolTip="Reload diagnosis-export.csv"/>
                    <Button x:Name="BtnBrowse" Content="..." Width="30" Click="BtnBrowse_Click"
                            Margin="6,0,0,0" Background="#1E3F7A" Foreground="White"
                            BorderBrush="#4A7FBA" ToolTip="Choose CSV file" MinWidth="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#E8E8E8" BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="No data loaded." VerticalAlignment="Center"
                           Foreground="#555" FontSize="12"/>
                <TextBlock x:Name="TxtFile" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#888" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Search filters -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel>
                <Label Content="Name:" Style="{StaticResource SearchLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource SearchBox}"
                         ToolTip="Surname or first name (partial match)"
                         TextChanged="Filter_Changed"/>

                <Label Content="DOB:" Margin="10,0,0,0" Style="{StaticResource SearchLabel}"/>
                <TextBox x:Name="TxtDOB" Style="{StaticResource SearchBox}" Width="100"
                         ToolTip="Date of birth e.g. 1965-03-14 (partial match)"
                         TextChanged="Filter_Changed"/>

                <Label Content="PHN:" Margin="10,0,0,0" Style="{StaticResource SearchLabel}"/>
                <TextBox x:Name="TxtPHN" Style="{StaticResource SearchBox}"
                         ToolTip="Health card / PHN (partial match)"
                         TextChanged="Filter_Changed"/>

                <Label Content="Dx Code:" Margin="10,0,0,0" Style="{StaticResource SearchLabel}"/>
                <TextBox x:Name="TxtDxCode" Style="{StaticResource SearchBox}"
                         ToolTip="Diagnosis code e.g. AVASTIN (partial match)"
                         TextChanged="Filter_Changed"/>

                <Label Content="Dx Description:" Margin="10,0,0,0" Style="{StaticResource SearchLabel}"/>
                <TextBox x:Name="TxtDxDesc" Style="{StaticResource WideSearchBox}"
                         ToolTip="Diagnosis description text (partial match)"
                         TextChanged="Filter_Changed"/>

                <Button x:Name="BtnClear" Content="Clear" Margin="12,0,0,0"
                        Click="BtnClear_Click" Background="#F0F0F0"/>
            </WrapPanel>
        </Border>

        <!-- Main content: patient grid + detail panel -->
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="180" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Patient results grid -->
            <DataGrid x:Name="GridPatients" Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="GridPatients_SelectionChanged"
                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                      RowBackground="White"
                      AlternatingRowBackground="#F8F9FF"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      BorderBrush="#CCCCCC"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding PatientID}"  Width="65"/>
                    <DataGridTextColumn Header="Surname"   Binding="{Binding SurName}"    Width="140"/>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120"/>
                    <DataGridTextColumn Header="DOB"       Binding="{Binding DOB}"        Width="100"/>
                    <DataGridTextColumn Header="PHN"       Binding="{Binding PHN}"        Width="115"/>
                    <DataGridTextColumn Header="Sex"       Binding="{Binding Sex}"        Width="45"/>
                    <DataGridTextColumn Header="Phone"     Binding="{Binding HomePhone}"  Width="110"/>
                    <DataGridTextColumn Header="Dx Codes"  Binding="{Binding DxSummary}"  Width="*"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="24"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D0E4FF"/>
                                <Setter Property="Foreground" Value="#111"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" ShowsPreview="True"/>

            <!-- Detail panel -->
            <Border Grid.Row="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
                <DockPanel>
                    <!-- Detail header -->
                    <Border DockPanel.Dock="Top" Background="#EEF3FB" BorderBrush="#D0D8EE"
                            BorderThickness="0,0,0,1" Padding="10,5">
                        <DockPanel>
                            <TextBlock x:Name="TxtDetailHeader" Text="Select a patient to view diagnoses"
                                       FontWeight="SemiBold" Foreground="#2B579A" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="BtnCopyPHN" Content="Copy PHN" Click="BtnCopyPHN_Click"
                                        IsEnabled="False" Margin="0,0,6,0" Background="#F0F0F0"
                                        ToolTip="Copy PHN to clipboard to paste into Profile search"/>
                                <Button x:Name="BtnCopyName" Content="Copy Name" Click="BtnCopyName_Click"
                                        IsEnabled="False" Background="#F0F0F0"
                                        ToolTip="Copy full name to clipboard"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Diagnosis detail grid -->
                    <DataGrid x:Name="GridDiagnoses"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeRows="False"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              RowBackground="White"
                              AlternatingRowBackground="#FFFBF0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              BorderThickness="0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dx Code"      Binding="{Binding DxCode}"        Width="110"/>
                            <DataGridTextColumn Header="Description"  Binding="{Binding DxDescription}" Width="*"/>
                            <DataGridTextColumn Header="Date"         Binding="{Binding DxDate}"        Width="95"/>
                            <DataGridTextColumn Header="Status"       Binding="{Binding DxStatus}"      Width="65"/>
                            <DataGridTextColumn Header="Alert"        Binding="{Binding DxAlert}"       Width="55"/>
                            <DataGridTextColumn Header="Comment"      Binding="{Binding DxComment}"     Width="200"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="22"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
